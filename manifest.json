{
    "manifest_version": 3,
    "name": "Muslim Reminder",
    "version": "1.0.0",
    "description": "A new tab extension showing Islamic dhikr reminders, prayer times, and customizable shortcuts",
    "icons": {
        "128" : "icon/icon128.png",
        "48" : "icon/icon48.png",
        "16" : "icon/icon16.png"
    },
    "action" : {
        "default_icon": "icon/icon16.png",
        "default_popup": "popup.html"
    },
    "permissions" : ["storage"],
    "host_permissions": ["https://api.aladhan.com/*"],
    "options_page": "options.html",
    "chrome_url_overrides":{
        "newtab":"new.html"
    }
}
